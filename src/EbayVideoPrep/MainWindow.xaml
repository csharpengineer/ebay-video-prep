<Window x:Class="EbayVideoPrep.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        mc:Ignorable="d"
        Title="eBay Video Prep"
        Width="1100"
        Height="760"
        MinWidth="760"
        MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        AllowDrop="True"
        DragOver="Window_DragOver"
        Drop="Window_Drop">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#D9DEE3"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Open Video"
                            Click="OpenVideo_Click"
                            Padding="18,8"
                            Margin="0,0,8,0" />
                    <Button Content="Reset Crop"
                            Click="ResetCrop_Click"
                            Padding="14,8"
                            Margin="0,0,8,0" />
                    <Button Content="Square"
                            Click="SquareCrop_Click"
                            Padding="14,8" />
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            DockPanel.Dock="Right">
                    <TextBlock x:Name="CropInfoText"
                               VerticalAlignment="Center"
                               Foreground="#59636E"
                               Margin="0,0,14,0"
                               Text="No video loaded" />
                    <Button x:Name="SaveButton"
                            Content="Save eBay MP4"
                            Click="SaveVideo_Click"
                            IsEnabled="False"
                            Padding="20,8"
                            FontWeight="SemiBold" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="16">
            <Border Background="#111417"
                    BorderBrush="#C7CDD3"
                    BorderThickness="1"
                    CornerRadius="6"
                    ClipToBounds="True">
                <Grid x:Name="PreviewHost"
                      SizeChanged="PreviewHost_SizeChanged">
                    <!--
                        MediaElement does not consistently honor MP4/MOV display-rotation metadata.
                        Keep it in a Canvas so code-behind can explicitly size, position, and rotate
                        the stored video frame while the crop overlay uses display-oriented geometry.
                    -->
                    <Canvas x:Name="VideoCanvas"
                            IsHitTestVisible="False">
                        <MediaElement x:Name="VideoPlayer"
                                      Stretch="Fill"
                                      LoadedBehavior="Manual"
                                      UnloadedBehavior="Manual"
                                      ScrubbingEnabled="True"
                                      IsMuted="True"
                                      RenderTransformOrigin="0.5,0.5"
                                      MediaOpened="VideoPlayer_MediaOpened"
                                      MediaEnded="VideoPlayer_MediaEnded"
                                      MediaFailed="VideoPlayer_MediaFailed" />
                    </Canvas>

                    <TextBlock x:Name="DropHint"
                               Text="Drop an MP4 or MOV here&#x0a;or click Open Video"
                               Foreground="#D9DEE3"
                               FontSize="24"
                               FontWeight="SemiBold"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               IsHitTestVisible="False" />

                    <Canvas x:Name="CropCanvas"
                            Background="Transparent"
                            Visibility="Collapsed">
                        <Rectangle x:Name="ShadeTop"
                                   Fill="#88000000"
                                   IsHitTestVisible="False" />
                        <Rectangle x:Name="ShadeBottom"
                                   Fill="#88000000"
                                   IsHitTestVisible="False" />
                        <Rectangle x:Name="ShadeLeft"
                                   Fill="#88000000"
                                   IsHitTestVisible="False" />
                        <Rectangle x:Name="ShadeRight"
                                   Fill="#88000000"
                                   IsHitTestVisible="False" />

                        <Border x:Name="CropBorder"
                                BorderBrush="#55A7FF"
                                BorderThickness="2"
                                IsHitTestVisible="False"
                                Panel.ZIndex="5" />

                        <!-- Opacity=0 keeps the whole crop interior draggable without painting it. -->
                        <primitives:Thumb x:Name="MoveThumb"
                                          Cursor="SizeAll"
                                          Opacity="0"
                                          DragDelta="MoveThumb_DragDelta"
                                          Panel.ZIndex="6" />

                        <primitives:Thumb Tag="TopLeft"
                                          Width="16" Height="16"
                                          Cursor="SizeNWSE"
                                          Background="White"
                                          BorderBrush="#17202A"
                                          BorderThickness="1"
                                          DragDelta="ResizeThumb_DragDelta"
                                          Panel.ZIndex="10" />
                        <primitives:Thumb Tag="Top"
                                          Width="16" Height="16"
                                          Cursor="SizeNS"
                                          Background="White"
                                          BorderBrush="#17202A"
                                          BorderThickness="1"
                                          DragDelta="ResizeThumb_DragDelta"
                                          Panel.ZIndex="10" />
                        <primitives:Thumb Tag="TopRight"
                                          Width="16" Height="16"
                                          Cursor="SizeNESW"
                                          Background="White"
                                          BorderBrush="#17202A"
                                          BorderThickness="1"
                                          DragDelta="ResizeThumb_DragDelta"
                                          Panel.ZIndex="10" />
                        <primitives:Thumb Tag="Right"
                                          Width="16" Height="16"
                                          Cursor="SizeWE"
                                          Background="White"
                                          BorderBrush="#17202A"
                                          BorderThickness="1"
                                          DragDelta="ResizeThumb_DragDelta"
                                          Panel.ZIndex="10" />
                        <primitives:Thumb Tag="BottomRight"
                                          Width="16" Height="16"
                                          Cursor="SizeNWSE"
                                          Background="White"
                                          BorderBrush="#17202A"
                                          BorderThickness="1"
                                          DragDelta="ResizeThumb_DragDelta"
                                          Panel.ZIndex="10" />
                        <primitives:Thumb Tag="Bottom"
                                          Width="16" Height="16"
                                          Cursor="SizeNS"
                                          Background="White"
                                          BorderBrush="#17202A"
                                          BorderThickness="1"
                                          DragDelta="ResizeThumb_DragDelta"
                                          Panel.ZIndex="10" />
                        <primitives:Thumb Tag="BottomLeft"
                                          Width="16" Height="16"
                                          Cursor="SizeNESW"
                                          Background="White"
                                          BorderBrush="#17202A"
                                          BorderThickness="1"
                                          DragDelta="ResizeThumb_DragDelta"
                                          Panel.ZIndex="10" />
                        <primitives:Thumb Tag="Left"
                                          Width="16" Height="16"
                                          Cursor="SizeWE"
                                          Background="White"
                                          BorderBrush="#17202A"
                                          BorderThickness="1"
                                          DragDelta="ResizeThumb_DragDelta"
                                          Panel.ZIndex="10" />
                    </Canvas>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#D9DEE3"
                BorderThickness="0,1,0,0"
                Padding="14,8">
            <DockPanel LastChildFill="True">
                <ProgressBar x:Name="ExportProgress"
                             DockPanel.Dock="Right"
                             Width="170"
                             Height="8"
                             IsIndeterminate="True"
                             Visibility="Collapsed"
                             Margin="14,0,0,0" />
                <TextBlock x:Name="StatusText"
                           Foreground="#59636E"
                           Text="Ready. Drop a video into the window." />
            </DockPanel>
        </Border>
    </Grid>
</Window>
